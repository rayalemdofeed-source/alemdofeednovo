---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import VideoStrip from "../components/VideoStrip.astro";
import ParaQuem from "../components/ParaQuem.astro";
import Principio from "../components/Principio.astro";
import Marquee from "../components/Marquee.astro";
import ComoFunciona from "../components/ComoFunciona.astro";
import Autoridade from "../components/Autoridade.astro";
import Depoimento from "../components/Depoimento.astro";
import Oferta from "../components/Oferta.astro";
import FAQ from "../components/FAQ.astro";
import CTAFinal from "../components/CTAFinal.astro";
import Footer from "../components/Footer.astro";
import FloatingCTA from "../components/FloatingCTA.astro";
---

<Layout
  title="Jornada Além do Feed — branding pessoal com Rayane Guimarães"
  description="Três meses de acompanhamento para traduzir quem você é em posicionamento, presença e material visual profissional. Vagas limitadas na próxima turma."
>
  <Header />
  <main>
    <Hero />
    <VideoStrip />
    <ParaQuem />
    <Principio />
    <Marquee />
    <ComoFunciona />
    <Autoridade />
    <Depoimento />
    <Oferta />
    <FAQ />
    <CTAFinal />
  </main>
  <Footer />
  <FloatingCTA />
</Layout>
