---
import { Image } from "astro:assets";
import hero from "../assets/fotos/hero-arcos.jpg";
import { waLink } from "../lib/consts";
---

<section class="hero" id="topo">
  <div class="glow" aria-hidden="true"></div>
  <canvas class="glow-gl" aria-hidden="true"></canvas>
  <div class="hero-inner">
    <div class="copy">
      <p class="eyebrow enter">Jornada Além do Feed</p>
      <h1 class="enter" style="animation-delay: 60ms">
        Posicionamento real, <em
          >traduzido com <span class="scribble-wrap"
            >método<svg
              class="scribble"
              viewBox="0 0 400 40"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path
                d="M4,24 C 40,6 66,38 104,20 C 142,2 172,36 214,18 C 252,2 280,34 320,16 C 344,6 362,20 378,12"
                pathLength="100"></path>
            </svg></span
          >.</em
        >
      </h1>
      <p class="lead enter" style="animation-delay: 140ms">
        O Além do Feed é uma consultoria de marca pessoal para mulheres que
        querem comunicar e se posicionar com verdade e estratégia.
      </p>
      <a
        class="cta enter btn-glass"
        style="animation-delay: 220ms"
        href={waLink("Oii Ray 🤎 vi a Jornada no site e já quero começar a minha")}
      >
        Quero a Jornada
      </a>
    </div>
    <div class="figure enter" style="animation-delay: 120ms">
      <Image
        src={hero}
        alt="Rayane Guimarães sorrindo diante de uma fachada com arcadas, em dia ensolarado"
        width={1000}
        height={1333}
        widths={[400, 700, 1000]}
        sizes="(min-width: 900px) 42vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    --mx1: 12%;
    --my1: 18%;
    position: relative;
    background: var(--bg-light);
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-6);
    align-items: center;
    max-width: 1240px;
    margin-inline: auto;
    padding: clamp(2.5rem, 6vw, var(--space-7)) clamp(1.25rem, 5vw, 4rem);
  }

  .glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: min(100%, 900px);
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .glow::before,
  .glow::after {
    content: "";
    position: absolute;
    aspect-ratio: 1;
    border-radius: 50%;
    translate: -50% -50%;
    will-change: left, top;
  }

  .glow::before {
    left: var(--mx1);
    top: var(--my1);
    width: min(62vw, 760px);
    filter: blur(105px);
    background: var(--primary);
    opacity: 0.32;
  }

  .glow::after {
    left: 76%;
    top: 66%;
    width: min(50vw, 600px);
    filter: blur(95px);
    background: var(--secondary);
    opacity: 0.26;
  }

  .glow-gl {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: min(100%, 900px);
    z-index: 0;
    width: 100%;
    pointer-events: none;
    opacity: 0;
  }

  .hero.webgl-ready .glow {
    display: none;
  }

  .hero.webgl-ready .glow-gl {
    opacity: 1;
  }

  .copy,
  .figure {
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero:not(.mouse-active) .glow::before {
      animation: glow-drift-a 28s ease-in-out infinite;
    }

    .hero .glow::after {
      animation: glow-drift-b 34s ease-in-out infinite;
    }
  }

  @keyframes glow-drift-a {
    0% {
      left: 6%;
      top: 10%;
    }
    33% {
      left: 28%;
      top: 38%;
    }
    66% {
      left: 12%;
      top: 46%;
    }
    100% {
      left: 6%;
      top: 10%;
    }
  }

  @keyframes glow-drift-b {
    0% {
      left: 76%;
      top: 66%;
    }
    40% {
      left: 60%;
      top: 44%;
    }
    70% {
      left: 82%;
      top: 40%;
    }
    100% {
      left: 76%;
      top: 66%;
    }
  }

  /* Deriva extra ligada ao scroll: soma-se ao drift automático (que já
     roda sozinho, inclusive no mobile) para dar mais uma camada de
     movimento reativo em quem não tem mouse pra interagir. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .glow,
      .glow-gl {
        animation: glow-scroll-parallax linear both;
        animation-timeline: scroll(root);
        animation-range: 0 80vh;
      }
    }
  }

  @keyframes glow-scroll-parallax {
    from {
      transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
    }
    to {
      transform: translate3d(0, 9%, 0) rotate(2.5deg) scale(1.06);
    }
  }

  .copy {
    max-width: 52ch;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: var(--space-3);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: var(--secondary);
  }

  h1 em {
    position: relative;
    font-style: italic;
    color: var(--primary);
  }

  /* Envolve só a palavra "método" num inline-block: garante uma única
     caixa (nunca fragmentada em mais de uma linha), pra o SVG do rabisco
     se ancorar num tamanho/posição confiável em qualquer largura de tela. */
  .scribble-wrap {
    position: relative;
    display: inline-block;
  }

  .scribble {
    position: absolute;
    left: -0.02em;
    right: -0.02em;
    bottom: -0.22em;
    width: calc(100% + 0.04em);
    height: 0.42em;
    overflow: visible;
    pointer-events: none;
  }

  .scribble path {
    fill: none;
    stroke: var(--primary);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
    vector-effect: non-scaling-stroke;
    opacity: 0.75;
  }

  @media (prefers-reduced-motion: no-preference) {
    .scribble path {
      stroke-dashoffset: 100;
      animation: scribble-in 650ms var(--ease-out) 550ms both;
    }
  }

  @keyframes scribble-in {
    to {
      stroke-dashoffset: 0;
    }
  }

  .lead {
    margin-top: var(--space-3);
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .cta {
    display: inline-block;
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.03em;
    text-decoration: none;
    color: var(--bg-light);
    background: rgba(180, 94, 52, 0.82);
    border: 1px solid rgba(242, 232, 219, 0.3);
    border-radius: 999px;
    padding: 0.95em 2em;
    box-shadow: 0 0 0 0 var(--glow-primary);
  }

  .cta:hover,
  .cta:focus-visible {
    background: rgba(107, 58, 31, 0.88);
    box-shadow: 0 0 64px 12px var(--glow-primary);
  }

  .figure {
    border-radius: 260px 260px 4px 4px;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .figure :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transform: scale(1.14);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .figure :global(img) {
        animation: img-parallax linear both;
        animation-timeline: view();
      }
    }
  }

  @keyframes img-parallax {
    from {
      transform: scale(1.14) translateY(-4%);
    }
    to {
      transform: scale(1.14) translateY(4%);
    }
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr 0.85fr;
    }
  }
</style>

<script>
  // Ilha do hero: duas bolhas de fundo.
  // 1) Fallback CSS (blur + circle) — sempre no DOM, é o que se vê por
  //    padrão e o que fica se WebGL não estiver disponível ou o usuário
  //    pedir menos movimento.
  // 2) WebGL (canvas.glow-gl) — substitui o fallback quando o navegador
  //    suporta, dá uma bolha orgânica que segue o mouse com inércia.
  const hero = document.querySelector<HTMLElement>(".hero");
  const canHover = matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Fallback CSS: mantém o comportamento anterior (segue o mouse via
  // custom properties) para quem não tiver WebGL.
  if (hero && canHover && !reduceMotion) {
    hero.addEventListener("pointermove", (e) => {
      const rect = hero.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      hero.classList.add("mouse-active");
      hero.style.setProperty("--mx1", `${x}%`);
      hero.style.setProperty("--my1", `${y}%`);
    });

    hero.addEventListener("pointerleave", () => {
      hero.classList.remove("mouse-active");
    });
  }

  // WebGL: só entra se o navegador suportar e o usuário aceitar movimento.
  // O canvas WebGL fica só em telas largas (onde o hero tem as duas
  // colunas e o mouse existe de fato). Em telas estreitas, o fallback
  // CSS (mais leve, sem risco de disputa de memória de GPU com o resto
  // da página) já cobre bem o efeito.
  const isWideScreen = matchMedia("(min-width: 900px)").matches;
  if (hero && !reduceMotion && isWideScreen) initWebglGlow(hero);

  function initWebglGlow(hero: HTMLElement) {
    const canvas = hero.querySelector<HTMLCanvasElement>(".glow-gl");
    if (!canvas) return;

    const gl = canvas.getContext("webgl", {
      alpha: true,
      antialias: false,
      premultipliedAlpha: true,
    });
    if (!gl) return; // sem WebGL: fica no fallback CSS

    const vertexSrc = `
      attribute vec2 a_pos;
      void main() {
        gl_Position = vec4(a_pos, 0.0, 1.0);
      }
    `;

    const fragmentSrc = `
      precision mediump float;
      uniform vec2 u_resolution;
      uniform vec2 u_blob1;
      uniform vec2 u_blob2;
      uniform vec2 u_blob3;
      uniform float u_radius1;
      uniform float u_radius2;
      uniform float u_radius3;
      uniform vec3 u_color1;
      uniform vec3 u_color2;
      uniform vec3 u_color3;

      float grain(vec2 co) {
        return fract(sin(dot(co, vec2(12.9898, 78.233))) * 43758.5453);
      }

      void main() {
        vec2 frag = vec2(gl_FragCoord.x, u_resolution.y - gl_FragCoord.y);

        float d1 = 1.0 - smoothstep(0.0, u_radius1, distance(frag, u_blob1));
        float d2 = 1.0 - smoothstep(0.0, u_radius2, distance(frag, u_blob2));
        float d3 = 1.0 - smoothstep(0.0, u_radius3, distance(frag, u_blob3));

        float total = d1 + d2 + d3 + 0.0001;
        vec3 mesh = (u_color1 * d1 + u_color2 * d2 + u_color3 * d3) / total;

        float coverage = max(d1, max(d2, d3));
        float alpha = pow(coverage, 1.05) * 0.62;

        float n = (grain(gl_FragCoord.xy) - 0.5) * 0.1;
        vec3 color = mesh + n;

        gl_FragColor = vec4(color * alpha, alpha);
      }
    `;

    function compile(type: number, source: string) {
      const shader = gl!.createShader(type)!;
      gl!.shaderSource(shader, source);
      gl!.compileShader(shader);
      if (!gl!.getShaderParameter(shader, gl!.COMPILE_STATUS)) {
        gl!.deleteShader(shader);
        return null;
      }
      return shader;
    }

    const vs = compile(gl.VERTEX_SHADER, vertexSrc);
    const fs = compile(gl.FRAGMENT_SHADER, fragmentSrc);
    if (!vs || !fs) return;

    const program = gl.createProgram()!;
    gl.attachShader(program, vs);
    gl.attachShader(program, fs);
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return;
    gl.useProgram(program);

    const posBuffer = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, posBuffer);
    gl.bufferData(
      gl.ARRAY_BUFFER,
      new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]),
      gl.STATIC_DRAW,
    );
    const posLoc = gl.getAttribLocation(program, "a_pos");
    gl.enableVertexAttribArray(posLoc);
    gl.vertexAttribPointer(posLoc, 2, gl.FLOAT, false, 0, 0);

    const u = {
      resolution: gl.getUniformLocation(program, "u_resolution"),
      blob1: gl.getUniformLocation(program, "u_blob1"),
      blob2: gl.getUniformLocation(program, "u_blob2"),
      blob3: gl.getUniformLocation(program, "u_blob3"),
      radius1: gl.getUniformLocation(program, "u_radius1"),
      radius2: gl.getUniformLocation(program, "u_radius2"),
      radius3: gl.getUniformLocation(program, "u_radius3"),
      color1: gl.getUniformLocation(program, "u_color1"),
      color2: gl.getUniformLocation(program, "u_color2"),
      color3: gl.getUniformLocation(program, "u_color3"),
    };

    // Cores da marca: terracota, vinho mais saturado, terracota claro. 0..1
    gl.uniform3f(u.color1, 180 / 255, 94 / 255, 52 / 255);
    gl.uniform3f(u.color2, 140 / 255, 64 / 255, 64 / 255);
    gl.uniform3f(u.color3, 216 / 255, 150 / 255, 118 / 255);

    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let width = 0;
    let height = 0;

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      width = Math.max(1, Math.round(rect.width * dpr));
      height = Math.max(1, Math.round(rect.height * dpr));
      canvas!.width = width;
      canvas!.height = height;
      gl!.viewport(0, 0, width, height);
      gl!.uniform2f(u.resolution, width, height);
    }
    resize();

    const ro = new ResizeObserver(resize);
    ro.observe(hero);

    // Estado alvo (0..1 relativo ao hero) e posição suavizada da bolha 1.
    let targetX = 0.16;
    let targetY = 0.22;
    let curX = targetX;
    let curY = targetY;
    let following = false;

    hero.addEventListener("pointermove", (e) => {
      const rect = canvas!.getBoundingClientRect();
      targetX = (e.clientX - rect.left) / rect.width;
      targetY = (e.clientY - rect.top) / rect.height;
      following =
        targetY >= -0.15 && targetY <= 1.15 && targetX >= -0.15 && targetX <= 1.15;
    });
    hero.addEventListener("pointerleave", () => {
      following = false;
    });

    let raf = 0;
    let visible = !document.hidden;
    const updateVisible = () => {
      visible = !document.hidden;
    };
    let start = performance.now();

    // Deriva ligada ao scroll: além do mouse (desktop) e da órbita
    // automática, o mesh também reage a rolar a página — assim quem
    // não tem mouse (trackpad parado, etc.) ainda vê o fundo vivo.
    let scrollShift = 0;
    function updateScroll() {
      const rect = hero.getBoundingClientRect();
      const total = rect.height + window.innerHeight;
      const passed = window.innerHeight - rect.top;
      scrollShift = Math.min(1, Math.max(0, passed / total));
    }
    window.addEventListener("scroll", updateScroll, { passive: true });
    updateScroll();

    function frame(now: number) {
      raf = requestAnimationFrame(frame);
      if (!visible) return;

      const t = (now - start) / 1000;

      if (following) {
        curX += (targetX - curX) * 0.06;
        curY += (targetY - curY) * 0.06;
      } else {
        // deriva orgânica quando o mouse não está por perto
        curX = 0.18 + Math.sin(t * 0.25) * 0.1;
        curY = 0.24 + Math.cos(t * 0.2) * 0.12;
      }

      // Blob 2 e 3 fluem sozinhos o tempo todo, em órbitas com períodos
      // diferentes, pra nunca repetir o mesmo desenho — é isso que dá a
      // sensação de gradiente "vivo" em vez de uma mancha parada.
      const b2x = 0.72 + Math.sin(t * 0.14 + 1.3) * 0.14;
      const b2y = 0.28 + Math.cos(t * 0.11 + 0.4) * 0.16;
      const b3x = 0.42 + Math.sin(t * 0.09 + 3.1) * 0.22;
      const b3y = 0.82 + Math.cos(t * 0.13 + 2.2) * 0.14;

      const shift = scrollShift * 0.1;

      const minSide = Math.min(width, height);
      gl!.uniform2f(u.blob1, curX * width, (curY + shift) * height);
      gl!.uniform2f(u.blob2, b2x * width, (b2y + shift * 0.6) * height);
      gl!.uniform2f(u.blob3, b3x * width, (b3y - shift * 0.5) * height);
      gl!.uniform1f(u.radius1, minSide * 0.58);
      gl!.uniform1f(u.radius2, minSide * 0.5);
      gl!.uniform1f(u.radius3, minSide * 0.56);

      gl!.clearColor(0, 0, 0, 0);
      gl!.clear(gl!.COLOR_BUFFER_BIT);
      gl!.drawArrays(gl!.TRIANGLE_STRIP, 0, 4);
    }

    document.addEventListener("visibilitychange", updateVisible);

    hero.classList.add("webgl-ready");
    raf = requestAnimationFrame(frame);
  }
</script>
