---
import { waLink } from "../lib/consts";
---

<section class="oferta">
  <div class="inner">
    <p class="eyebrow reveal">A Jornada</p>
    <blockquote class="pull-quote reveal">
      Você sai da Jornada com clareza, direção e tudo o que precisa para se
      posicionar com convicção.
    </blockquote>

    <div class="card reveal">
      <div class="card-head">
        <h2>Jornada Além do Feed</h2>
        <p class="formato">
          Acompanhamento de 3 meses · online ou presencial (no Recife)
        </p>
      </div>

      <div class="vagas">
        <span class="valor">5 vagas disponíveis</span>
        <p class="vagas-texto">
          Cada Jornada são três meses de acompanhamento lado a lado. Por
          isso, apenas cinco vagas por vez, que é o que permite manter a
          profundidade que o processo pede.
        </p>
      </div>

      <a
        class="cta btn-glass"
        href={waLink("Olá, Rayane! Vi que tem vagas abertas pra próxima turma da Jornada Além do Feed e quero garantir a minha.")}
      >
        Quero uma das vagas
      </a>
    </div>
  </div>
</section>

<style>
  .inner {
    max-width: 700px;
    margin-inline: auto;
    padding: clamp(3rem, 7vw, var(--space-7)) clamp(1.25rem, 5vw, 4rem);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: var(--space-3);
    text-align: center;
  }

  .pull-quote {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    line-height: 1.35;
    text-align: center;
    color: var(--secondary);
    text-wrap: balance;
    margin: 0 0 var(--space-6);
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--primary-30);
    border-top: 6px solid var(--primary);
    border-radius: 20px;
    padding: clamp(1.75rem, 5vw, var(--space-5));
    box-shadow: 0 24px 60px -20px var(--glow-primary);
    transition:
      transform 380ms var(--ease-out),
      border-color 380ms var(--ease-out),
      box-shadow 900ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      transform: translateY(-6px);
      border-color: var(--primary);
      box-shadow: 0 32px 84px -16px var(--glow-primary);
    }
  }

  .card-head h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.75rem;
    color: var(--secondary);
  }

  .formato {
    margin-top: var(--space-1);
    font-size: 0.9rem;
    color: var(--secondary);
  }

  .vagas {
    display: grid;
    gap: var(--space-2);
    margin-block: var(--space-4);
    padding-block: var(--space-3);
    border-block: 1px solid var(--border);
  }

  .valor {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4.5vw, 2.2rem);
    color: var(--primary);
  }

  .vagas-texto {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--secondary);
  }

  .cta {
    display: block;
    margin-top: var(--space-4);
    text-align: center;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.03em;
    text-decoration: none;
    color: var(--bg-light);
    background: rgba(180, 94, 52, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    padding: 1em;
    box-shadow: 0 0 0 0 var(--glow-primary);
  }

  .cta:hover,
  .cta:focus-visible {
    background: rgba(107, 58, 31, 0.9);
    box-shadow: 0 0 64px 12px var(--glow-primary);
  }
</style>
