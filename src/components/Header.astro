---
import { Image } from "astro:assets";
import logo from "../assets/logo/logo-terracota.png";
import { waLink } from "../lib/consts";
---

<header class="header">
  <a href="#topo" class="brand">
    <Image src={logo} alt="Além do Feed" height={28} loading="eager" />
  </a>
  <a
    class="cta btn-glass"
    href={waLink("Olá, Rayane! Vim pelo site e queria entender melhor como funciona a Jornada Além do Feed.")}
  >
    Falar com Ray
  </a>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-2) clamp(1.25rem, 5vw, 4rem);
    background: var(--bg-light);
    border-bottom: 1px solid var(--border);
  }

  .brand {
    display: flex;
    align-items: center;
  }

  .brand :global(img) {
    display: block;
    width: auto;
  }

  .cta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-on-light);
    background: rgba(255, 255, 255, 0.3);
    border: 1px solid rgba(58, 31, 20, 0.25);
    border-radius: 999px;
    padding: 0.6em 1.2em;
    white-space: nowrap;
    box-shadow: 0 0 0 0 var(--glow-primary);
  }

  .cta:hover,
  .cta:focus-visible {
    background: rgba(180, 94, 52, 0.16);
    border-color: rgba(180, 94, 52, 0.55);
    color: var(--primary-dark);
    box-shadow: 0 0 50px 8px var(--glow-primary);
  }

  @media (max-width: 420px) {
    .cta {
      font-size: 0.65rem;
      padding: 0.55em 0.75em;
    }
  }
</style>
