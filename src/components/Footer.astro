---
import { Image } from "astro:assets";
import logo from "../assets/logo/logo-terracota.png";
import { INSTAGRAM_HANDLE, INSTAGRAM_URL, EMAIL, LOCATION } from "../lib/consts";

const ano = new Date().getFullYear();
---

<footer class="footer">
  <div class="inner">
    <Image src={logo} alt="Além do Feed" height={24} loading="lazy" />
    <nav aria-label="Contato">
      <a href={INSTAGRAM_URL} target="_blank" rel="noopener">{INSTAGRAM_HANDLE}</a>
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <span>{LOCATION}</span>
    </nav>
    <p class="assinatura">Você INTEIRA pro que sempre foi seu! 🤎 · {ano}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-light);
    border-top: 1.5px solid var(--primary-30);
  }

  .inner {
    max-width: 1240px;
    margin-inline: auto;
    padding: var(--space-5) clamp(1.25rem, 5vw, 4rem);
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .inner :global(img) {
    width: auto;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.8rem;
    color: var(--text-on-light);
  }

  nav a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    transition:
      color 160ms var(--ease-out),
      border-color 160ms var(--ease-out);
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--primary);
    border-color: var(--primary);
  }

  .assinatura {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--primary);
  }
</style>
